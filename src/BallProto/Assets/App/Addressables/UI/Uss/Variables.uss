:root {
    /* ═══════════════════════════════════════════
       FONTS
       ═══════════════════════════════════════════ */
    --font-bold: url('/Assets/App/Addressables/Fonts/MPLUSRounded1c-Bold SDF.asset');

    -unity-font-definition: var(--font-bold);

    /* ═══════════════════════════════════════════
       COLORS
       ═══════════════════════════════════════════ */
    --color-primary: #E94560;
    --color-primary-dark: #B82E47;
    --color-surface-elevated: #3D3D6B;
    --color-border: #2F2F5A;
    --color-text: #FFFFFF;
    --color-text-tertiary: #71717A;
    --color-overlay: rgba(15, 15, 35, 0.85);
    --color-overlay-glass: rgba(15, 15, 35, 0.35);

    /* ═══════════════════════════════════════════
       SPACING
       ═══════════════════════════════════════════ */
    --space-xl: 24px;
    --space-2xl: 32px;
    --space-3xl: 48px;

    /* ═══════════════════════════════════════════
       TYPOGRAPHY
       ═══════════════════════════════════════════ */
    --font-lg: 36px;

    /* ═══════════════════════════════════════════
       BORDER RADIUS
       ═══════════════════════════════════════════ */
    --radius-lg: 24px;
    --radius-full: 9999px;

    /* ═══════════════════════════════════════════
       BORDER WIDTH
       ═══════════════════════════════════════════ */
    --border-width-sm: 1px;
    --border-width-lg: 4px;
    --border-width-xl: 6px;

    /* ═══════════════════════════════════════════
       TRANSITIONS
       ═══════════════════════════════════════════ */
    --transition-fast: 0.15s;

    /* ═══════════════════════════════════════════
       SCALE
       ═══════════════════════════════════════════ */
    --scale-press: 0.95;

    /* ═══════════════════════════════════════════
       SIZES
       ═══════════════════════════════════════════ */
    --size-button-height: 88px;
    --size-button-min-width: 200px;
    --size-spinner: 48px;

    /* ═══════════════════════════════════════════
       LAYOUT
       ═══════════════════════════════════════════ */
    --layout-screen-padding: 24px;
    --layout-game-button-width: 100%;

    /* ═══════════════════════════════════════════
       SCREEN: Game
       ═══════════════════════════════════════════ */
    --game-title-size: 72px;
    --game-hint-size: 32px;
}
