.game {
    flex-grow: 1;
    justify-content: flex-end;
    align-items: center;
}

.game__hint {
    position: absolute;
    bottom: 12%;
    font-size: var(--game-hint-size);
    -unity-font-definition: var(--font-bold);
    color: var(--color-text);
    }

.game__result {
    position: absolute;
    width: 100%;
    height: 100%;
    align-items: center;
    justify-content: center;
    background-color: var(--color-overlay-glass);
    padding: var(--layout-screen-padding);
}

.game__title {
    font-size: var(--game-title-size);
    -unity-font-definition: var(--font-bold);
    -unity-text-align: middle-center;
    white-space: normal;
    color: var(--color-text);
    margin-bottom: var(--space-3xl);
}

.game__retry {
    width: var(--layout-game-button-width);
}
